# --- Tableau Server / Tableau Cloud (shared by legacy /tableau routes AND
#     the new discovery/analysis/migration platform) ---
# Base URL of your Tableau Server or Tableau Cloud pod, no trailing slash.
# e.g. https://10ax.online.tableau.com  or  https://tableau.mycompany.com
TABLEAU_SERVER=https://your-tableau-server.example.com

# REST API version (see Tableau REST API reference for your server version)
TABLEAU_API_VERSION=3.21

# Metadata API (GraphQL) path -- standard for all Tableau Server/Cloud versions
TABLEAU_METADATA_API_PATH=/api/metadata/graphql

# --- OpenAI (Pre-Migration AI Analysis endpoints only; discovery-only /
#     legacy /tableau endpoints work without this) ---
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=4000

# --- App ---
APP_NAME=Tableau Pre-Migration Analysis Platform
APP_ENV=development
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=60

# Comma-separated list of allowed CORS origins, or * for all.
# Defaults to the local Vite dev server (see frontend/vite.config.ts, port 8080).
CORS_ALLOW_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- Legacy /tableau routes: workbook/datasource downloads are staged
#     locally then uploaded to Azure Blob (unchanged from the original
#     tableau_backend; not required for /discovery, /analysis, /analyze) ---
DOWNLOAD_DIR=./_tableau_downloads
AZURE_CONNECTION_STRING=your-azure-storage-connection-string
AZURE_CONTAINER_NAME=your-azure-container-name
